{
  "name": "@yorab/react-paint",
  "version": "1.0.0-beta.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "canvas",
    "whiteboard",
    "image annotation",
    "drawing",
    "annotation",
    "paint"
  ],
  "description": "An open-source canvas-based library for React used for image annotation or as a digital whiteboard.",
  "homepage": "https://yorab.github.io/react-paint-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorab/react-paint-editor.git"
  },
  "bugs": {
    "url": "https://github.com/yorab/react-paint-editor/issues"
  },
  "author": "Yohann Rabatel",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "main": "./dist/react-paint.umd.cjs",
  "module": "./dist/react-paint.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-paint.js",
      "require": "./dist/react-paint.umd.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./react-paint.css": "./dist/react-paint.css",
    "./editor/editor.css": "./dist/editor/editor.css"
  },
  "typesVersions": {
    "*": {
      "canvas": [
        "./dist/canvas/index.d.ts"
      ],
      "editor": [
        "./dist/editor/index.d.ts"
      ]
    }
  },
  "files": [
    "README.md",
    "LICENSE.txt",
    "package.json",
    "dist/"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.2",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "18.x || 19.x",
    "react-dom": "18.x || 19.x"
  },
  "scripts": {
    "bench": "vitest run --project=perf --reporter=default",
    "build": "rm -rf dist && vite build --config vite.config.umd.ts && vite build",
    "build-storybook": "storybook build",
    "check-package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm false-esm --exclude-entrypoints react-paint.css editor/editor.css",
    "check-treeshake": "node scripts/check-treeshake.mjs",
    "coverage-badge": "node scripts/coverage-badge.mjs",
    "declarationfiles": "rm -rf declarationfiles && pnpm tsc --project tsconfig.prod.json && node fixDtsPath.js",
    "lint": "pnpm biome check --write",
    "prepublishOnly": "pnpm build && pnpm declarationfiles",
    "publishnpm": "pnpm publish --access public",
    "start": "storybook dev -p 6006 --host 0.0.0.0",
    "test": "vitest --project=unit",
    "test-storybook": "vitest --project=storybook",
    "test-coverage": "vitest run --project=unit --project=storybook --coverage"
  }
}
